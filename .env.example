APP_ENV=development
LOG_LEVEL=INFO
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
TAVILY_API_KEY=
VECTOR_STORE_PATH=.vector_data
RAG_COLLECTION=getnet_products
RAG_TOP_K=4
RAG_MIN_RELEVANCE=0.45
REQUEST_TIMEOUT_SECONDS=15
TOTAL_REQUEST_TIMEOUT_SECONDS=90
ROUTER_USE_LLM=true
ROUTER_MAX_AGENTS=3
STATE_DB_PATH=.state/support.db
MEMORY_MAX_MESSAGES=12
OPERATOR_TOKEN=

# Example only: replace sample secrets before use; tokens bind the caller to a user_id.
API_CREDENTIALS_JSON={"demo-customer-token":{"user_id":"cliente1988","role":"customer"},"demo-second-token":{"user_id":"cliente2","role":"customer"}}

# Optional: supply verified current pricing; blank/zero means cost unknown.
INPUT_PRICE_PER_MILLION_USD=0
OUTPUT_PRICE_PER_MILLION_USD=0

# V7: bounded hybrid retrieval and factuality (LLM verifier recommended for live eval)
RAG_HYBRID_ENABLED=true
RAG_CANDIDATE_MULTIPLIER=3
RAG_LEXICAL_MAX_CHUNKS=1500
RAG_MAX_CHUNKS_PER_SOURCE=2
RAG_RERANK_RRF_K=60
RAG_VERIFIER_MODE=heuristic
RAG_VERIFIER_MIN_SCORE=0.85
MEMORY_RETENTION_DAYS=0

# Corporate deployment only: production disallows demo credentials.
# APP_ENV=production
# AUTH_MODE=oidc
# OIDC_ISSUER=https://idp.example.com/
# OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# OIDC_AUDIENCE=multi-agent-support
# OIDC_USER_CLAIM=sub
# OIDC_ROLE_CLAIM=roles
# OIDC_CUSTOMER_ROLE=customer
# OIDC_OPERATOR_ROLE=operator
# RAG_VERIFIER_MODE=llm
# OTLP_ENDPOINT=https://otel-collector.example.com/v1/traces
# OTLP_SERVICE_NAME=multi-agent-support

# Central PostgreSQL state is OPTIONAL. Do not set these for offline SQLite use.
# STATE_BACKEND=postgres
# STATE_DATABASE_URL=postgresql://user:password@localhost:5432/multi_agent_support
# REPLICAS=1  # >1 rejected until a shared vector service replaces embedded Chroma
